{
  "name": "xiaozhi-manager-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:no-check": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{vue,js,ts,jsx,tsx,json,scss,md}\"",
    "old:serve": "vue-cli-service serve",
    "old:build": "vue-cli-service build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "lucide-vue-next": "^0.453.0",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "pinia": "^2.2.4",
    "sm-crypto": "^0.3.13",
    "vue": "^3.5.10",
    "vue-i18n": "^10.0.3",
    "vue-router": "^4.4.5",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.10",
    "@vue/tsconfig": "^0.5.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.4",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.8",
    "vite-plugin-vue-devtools": "^7.4.4",
    "vue-tsc": "^2.1.6"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "ios >= 15",
    "android >= 9"
  ]
}
